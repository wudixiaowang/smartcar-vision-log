@echo off
chcp 936 >nul
title fospeed 标注工具
set PY=python
echo ============================================
echo   标注工具正在启动，窗口几秒后出来
echo   切类别按数字键：1 色块 / 2 锥桶 / 3 公仔（屏幕第一行大字会显示现在选的是哪个）
echo   框东西：鼠标左键按住，贴着物体边缘拖一个方框，松手就成了（自动保存）
echo   翻页：D 下一张 / A 上一张     其他：U 撤销一个框 / C 清空本张 / Q 退出
echo ============================================
"%PY%" "%~dp0标注工具.py"
echo.
echo ---- 工具关掉了 / EXIT=%ERRORLEVEL% ----
pause >nul
